managed implementation in class ybp_dd_r_customer_travel_26jv unique;
strict ( 2 );
with draft;

define behavior for YDD_R_CUSTOMER_TRAVEL_26JV //alias <alias_name>
persistent table ycusto_user_26jv
draft table YCUS_D_USER_26JV
lock master
total etag LastChangedAt
etag master LocalLastChangedAt
authorization master ( global, instance )
{
  create;
  update;
  delete;

  field ( numbering : managed, readonly ) CustomerUuid;
  field ( mandatory ) CustomerId ;
  field ( readonly ) Description ;

  action ( features : instance, authorization : update ) acceptClients result [1] $self ;
  action ( features : instance, authorization : update ) rejectClients result [1] $self ;

  validation validateCustomer on save { create; field CustomerId ; }
  determination setDescription on save { create; }

  determine action validateCustomerFormat { validation validateCustomer ; }
  side effects
  {
    field CustomerId affects field Description ;
    determine action validateCustomerFormat executed on field CustomerId affects messages ;
  }

  draft action Resume ;
  draft action Edit ;
  draft action Activate optimized ;
  draft action Discard ;

  draft determine action Prepare { validation validateCustomer ; }

  mapping for ycusto_user_26jv
  {
    CustomerId = customer_id;
    Description = description;
  }

}